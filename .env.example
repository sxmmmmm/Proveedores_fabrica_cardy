# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO GENERAL
# ==============================================================================
APP_NAME="Fábrica Cardy"
APP_ENV=local
APP_KEY=base64:AñadeTuAppKeyAquiSiUsasLaravel=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost

# ==============================================================================
# CONFIGURACIÓN DE LA BASE DE DATOS
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fabrica_cardy
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================================
# GESTIÓN DE SESIONES, CACHÉ Y COLAS (Configuraciones según la estructura de BD)
# ==============================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Drivers optimizados para usar las tablas nativas de tu base de datos
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=database
CACHE_PREFIX=fabrica_cardy_cache_

QUEUE_CONNECTION=database

# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE ARCHIVOS Y ALMACENAMIENTO
# ==============================================================================
FILESYSTEM_DISK=local

# ==============================================================================
# CONFIGURACIÓN DE SEGURIDAD Y ENCRIPTACIÓN
# ==============================================================================
BCRYPT_ROUNDS=12

# ==============================================================================
# CONFIGURACIÓN DE CORREO / NOTIFICACIONES (Ejemplo estándar para entorno local)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=samueltxl201@gmail.com
MAIL_PASSWORD="akwf ynja zyuf imiq"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="samueltxl201@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# CONFIGURACIÓN DE COMPILADORES DE FRONTEND (Vite / Frontend)
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"